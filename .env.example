# Copy to .env (never commit .env). Load it with your process manager, or:  set -a; . ./.env; set +a
# Code players type in the promo box to become admin. At least 8 characters. Leave empty to disable.
ADMIN_KEY_CODE=change-me-to-a-long-random-code
# Optional: where accounts are stored (default: accounts.json next to server.js)
# ACCOUNTS_FILE=/path/to/accounts.json
